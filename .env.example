# ─────────────────────────────────────────────────────────────
#  CareerAgent.ai — environment variables
#  Copy this file to `.env` for local use, and add the same
#  variables in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# 1) REQUIRED for production on Vercel  ✅ (recommended — the key stays secret on the server)
#    Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) OPTIONAL — which Gemini model to use (server side).
#    Default: gemini-flash-latest  (always points at Google's newest free-tier Flash model)
#    Note: gemini-1.5-flash / gemini-2.0-flash have been retired by Google.
GEMINI_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────
#  LOCAL DEV ONLY (when running plain `npm run dev` without `vercel dev`)
#  ⚠️ Anything starting with VITE_ is bundled into the browser JS and is PUBLIC.
#  Never set these on Vercel for a public site — use GEMINI_API_KEY above instead.
# ─────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=replace-with-your-gemini-api-key
VITE_GEMINI_MODEL=gemini-flash-latest
